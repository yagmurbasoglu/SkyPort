APP_NAME=SkyPort Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skyport
NOTAM_ENABLED=false
NOTAM_API_URL=https://notams.aim.faa.gov/notamSearch/search
NOTAM_LOCATIONS=LTBB,LTFM,LTBA,LTFJ
NOTAM_POLL_MINUTES=15
NOTAM_TIMEOUT_SEC=30
NOTAM_RETRY_COUNT=3
OSMNX_USE_CACHE=true
OSMNX_TIMEOUT_SEC=20
OSMNX_OVERPASS_TIMEOUT_SEC=20
# OSMNX_OVERPASS_URL=https://overpass-api.de/api/interpreter
WEATHER_ENABLED=true
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SEC=5
WEATHER_RETRY_COUNT=2
IBB_TRAFFIC_ENABLED=false
# Optional override. If omitted, the backend uses the official live IBB traffic API automatically.
# IBB_TRAFFIC_GEOJSON_PATH=data/official/ibb_traffic.geojson
# IBB_TRAFFIC_GEOJSON_URL=
IBB_TRAFFIC_TIMEOUT_SEC=10
TUIK_POPULATION_ENABLED=false
# Optional override. If omitted, the backend uses the official live TUIK district population API automatically.
# TUIK_POPULATION_CSV_PATH=data/official/tuik_population.csv
# TUIK_POPULATION_CSV_URL=
TUIK_POPULATION_TIMEOUT_SEC=10
